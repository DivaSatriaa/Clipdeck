[Desktop Entry]
Type=Application
Name=Clipdeck
GenericName=Clipboard History
Comment=Windows-style clipboard history for GNOME
Exec=@BINDIR@/clipdeck
Icon=@ICON@
Terminal=false
Categories=GTK;GNOME;Utility;
Keywords=clipboard;history;paste;copy;screenshot;
StartupNotify=true
StartupWMClass=io.github.divasatriaa.Clipdeck
DBusActivatable=false
